# URL of the Security Server
SERVER_URL=http://localhost:8000

# Display name for this client (defaults to hostname if left empty)
CLIENT_NAME=

# Populated automatically after first registration — do not edit manually
CLIENT_ID=
API_KEY=

# Seconds between full scan cycles
SCAN_INTERVAL=300

# Seconds between command polls
POLL_INTERVAL=30

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
